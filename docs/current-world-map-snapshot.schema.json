{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lw-control/current-world-map-snapshot.schema.json",
  "title": "LW-Control current world-map read-only snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "source", "captureId", "capturedAt", "heartbeat", "points"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "mode": { "const": "state" },
    "source": { "const": "WorldPointManager" },
    "captureId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "capturedAt": { "type": "string", "format": "date-time" },
    "heartbeat": { "$ref": "#/$defs/heartbeat" },
    "points": {
      "type": "array",
      "maxItems": 50000,
      "items": { "$ref": "#/$defs/point" }
    }
  },
  "$defs": {
    "heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probeVersion", "observedAt"],
      "properties": {
        "probeVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    },
    "nonNegativeInt": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "nonNegativeLong": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "boundedString": { "type": "string", "maxLength": 512 },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pointType", "uuid", "serverId", "srcServerId", "worldId"],
      "properties": {
        "id": { "$ref": "#/$defs/nonNegativeInt" },
        "pointType": { "$ref": "#/$defs/nonNegativeInt" },
        "uuid": { "$ref": "#/$defs/nonNegativeLong" },
        "serverId": { "$ref": "#/$defs/nonNegativeInt" },
        "srcServerId": { "$ref": "#/$defs/nonNegativeInt" },
        "worldId": { "$ref": "#/$defs/nonNegativeInt" },
        "buildInfo": { "anyOf": [{ "$ref": "#/$defs/buildInfo" }, { "type": "null" }] },
        "roadInfo": { "anyOf": [{ "$ref": "#/$defs/roadInfo" }, { "type": "null" }] },
        "collectResourceInfo": { "anyOf": [{ "$ref": "#/$defs/collectResourceInfo" }, { "type": "null" }] },
        "resourceInfo": { "anyOf": [{ "$ref": "#/$defs/resourceInfo" }, { "type": "null" }] },
        "explorePointInfo": { "anyOf": [{ "$ref": "#/$defs/eventPointInfo" }, { "type": "null" }] },
        "samplePointInfo": { "anyOf": [{ "$ref": "#/$defs/eventPointInfo" }, { "type": "null" }] },
        "garbagePointInfo": { "anyOf": [{ "$ref": "#/$defs/garbagePointInfo" }, { "type": "null" }] }
      }
    },
    "buildInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownerUid", "uuid", "buildId", "level", "buildState", "queueState", "allianceId",
        "updateEndTime", "updateStartTime", "lastHpTime", "protectEndTime", "inside", "currentHp",
        "name", "allianceAbbreviation", "lastCollectTime", "unavailableTime", "monthCardEndTime",
        "queueItemId", "queueStartTime", "queueUpdateTime", "destroyStartTime", "appearanceId",
        "specialType", "positionId"
      ],
      "properties": {
        "ownerUid": { "$ref": "#/$defs/boundedString" },
        "uuid": { "$ref": "#/$defs/nonNegativeLong" },
        "buildId": { "$ref": "#/$defs/nonNegativeInt" },
        "level": { "$ref": "#/$defs/nonNegativeInt" },
        "buildState": { "type": "integer" },
        "queueState": { "type": "integer" },
        "allianceId": { "$ref": "#/$defs/boundedString" },
        "updateEndTime": { "type": "integer" },
        "updateStartTime": { "type": "integer" },
        "lastHpTime": { "type": "integer" },
        "protectEndTime": { "type": "integer" },
        "inside": { "type": "integer" },
        "currentHp": { "type": "integer" },
        "name": { "$ref": "#/$defs/boundedString" },
        "allianceAbbreviation": { "$ref": "#/$defs/boundedString" },
        "lastCollectTime": { "type": "integer" },
        "unavailableTime": { "type": "integer" },
        "monthCardEndTime": { "type": "integer" },
        "queueItemId": { "type": "integer" },
        "queueStartTime": { "type": "integer" },
        "queueUpdateTime": { "type": "integer" },
        "destroyStartTime": { "type": "integer" },
        "appearanceId": { "type": "integer" },
        "specialType": { "type": "integer" },
        "positionId": { "$ref": "#/$defs/boundedString" }
      }
    },
    "roadInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownerUid", "uuid", "roadState", "inside", "currentHp", "allianceId"],
      "properties": {
        "ownerUid": { "$ref": "#/$defs/boundedString" },
        "uuid": { "$ref": "#/$defs/nonNegativeLong" },
        "roadState": { "type": "integer" },
        "inside": { "type": "integer" },
        "currentHp": { "type": "integer" },
        "allianceId": { "$ref": "#/$defs/boundedString" }
      }
    },
    "collectResourceInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceType", "level", "type", "attachId"],
      "properties": {
        "resourceType": { "$ref": "#/$defs/nonNegativeInt" },
        "level": { "$ref": "#/$defs/nonNegativeInt" },
        "type": { "$ref": "#/$defs/nonNegativeInt" },
        "attachId": { "$ref": "#/$defs/nonNegativeInt" }
      }
    },
    "resourceInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceId", "state", "gatherUuid"],
      "properties": {
        "resourceId": { "$ref": "#/$defs/nonNegativeInt" },
        "state": { "type": "integer" },
        "gatherUuid": { "$ref": "#/$defs/nonNegativeLong" }
      }
    },
    "eventPointInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownerUid", "uuid", "eventId"],
      "properties": {
        "ownerUid": { "$ref": "#/$defs/boundedString" },
        "uuid": { "$ref": "#/$defs/nonNegativeLong" },
        "eventId": { "$ref": "#/$defs/boundedString" }
      }
    },
    "garbagePointInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownerUid", "uuid", "eventId", "endTime"],
      "properties": {
        "ownerUid": { "$ref": "#/$defs/boundedString" },
        "uuid": { "$ref": "#/$defs/nonNegativeLong" },
        "eventId": { "$ref": "#/$defs/boundedString" },
        "endTime": { "$ref": "#/$defs/nonNegativeLong" }
      }
    }
  }
}
