  "html": "<section class=\"monster-afk-editor is-editing\"><div class=\"monster-afk-editor-heading\"><strong>Edit AFK Profile</strong><span class=\"monster-afk-mode-badge farm\">Actively attack targets</span></div><div class=\"monster-afk-config-section\"><strong>Basic settings</strong><div class=\"monster-afk-basic-grid\"><label><span>Profile Name</span><input value=\"Fixture profile\"></label><label><span>AFK Target</span><select><optgroup label=\"Common resources\"><option value=\"steel\" selected=\"\">Fixture Steel Search · Search · Attack · Attackable level: 1-10</option><option value=\"food\">Fixture Food Search · Search · Attack · Attackable level: 2-8</option></optgroup><optgroup label=\"Elite\"><option value=\"gold\">Fixture Gold Target · Live map · Attack</option></optgroup><optgroup label=\"Roaming monsters\"><option value=\"roaming\">Fixture Roaming Target · Live map · Attack</option></optgroup></select></label></div><div class=\"monster-afk-custom-target\"><label class=\"monster-afk-check-row\"><input type=\"checkbox\" checked=\"\">Custom target</label><label class=\"monster-afk-custom-name\"><span>Target name keyword</span><input aria-invalid=\"true\" value=\"\"><span class=\"muted\">Use only when the target is missing from the list. Match all or part of its name in the current game language; names are not translated automatically.</span><span role=\"status\" class=\"status-error\">Enter a target name; this change has not been saved.</span></label></div></div><div class=\"monster-afk-config-section\"><strong>Execution settings</strong><div class=\"monster-afk-basic-grid monster-afk-execution-grid\"><div class=\"monster-afk-squad-field\"><span>Squad Assignments</span><div class=\"monster-afk-squads\" role=\"group\" aria-label=\"Squad Assignments\"><button class=\"monster-afk-squad-toggle\" type=\"button\" aria-label=\"Squad 1\" aria-pressed=\"true\">1</button><button class=\"monster-afk-squad-toggle\" type=\"button\" aria-label=\"Squad 2\" aria-pressed=\"false\">2</button><button class=\"monster-afk-squad-toggle\" type=\"button\" aria-label=\"Squad 3\" aria-pressed=\"false\">3</button><button class=\"monster-afk-squad-toggle\" type=\"button\" aria-label=\"Squad 4\" aria-pressed=\"false\">4</button></div></div><label title=\"Counted separately per squad after each completed attack or rally; 0 loops indefinitely\"><span>Execution count (0 = unlimited)</span><input type=\"number\" min=\"0\" step=\"1\" value=\"0\"></label></div><label class=\"monster-afk-check-row\"><input type=\"checkbox\" checked=\"\">Continuous attacks (no return)</label></div><div class=\"monster-afk-config-section monster-afk-filter\"><strong>Target filters</strong><label class=\"monster-afk-check-row\"><input type=\"checkbox\">Limit level</label><label class=\"monster-afk-check-row\"><input type=\"checkbox\">Limit distance</label></div></section>",
