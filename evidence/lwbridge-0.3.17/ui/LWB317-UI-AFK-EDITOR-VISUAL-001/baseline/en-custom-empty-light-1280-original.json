  "html": "<div class=\"monster-afk-editor \"><div class=\"monster-afk-editor-heading\"><strong>Edit AFK Profile</strong><span class=\"monster-afk-mode-badge farm\">Actively attack targets</span></div><section class=\"monster-afk-config-section\"><h3>Basic settings</h3><div class=\"monster-afk-basic-grid\"><label>Profile Name<input value=\"Fixture profile\"></label><label>AFK Target<select><optgroup label=\"Common resources\"><option value=\"steel\" selected=\"\">Fixture Steel Search · Search · Attack · Attackable level: 1-10</option><option value=\"food\">Fixture Food Search · Search · Attack · Attackable level: 2-8</option></optgroup><optgroup label=\"Elite\"><option value=\"gold\">Fixture Gold Target · Live map · Attack</option></optgroup><optgroup label=\"Roaming monsters\"><option value=\"roaming\">Fixture Roaming Target · Live map · Attack</option></optgroup></select></label></div><div class=\"monster-afk-custom-target\"><label class=\"monster-afk-check-row\"><input type=\"checkbox\" checked=\"\">Custom target</label><label class=\"monster-afk-custom-name\">Target name keyword<input aria-invalid=\"true\" value=\"\"><span class=\"muted\">Use only when the target is missing from the list. Match all or part of its name in the current game language; names are not translated automatically.</span><span role=\"status\" class=\"status-error\">Enter a target name; this change has not been saved.</span></label></div></section><section class=\"monster-afk-config-section\"><h3>Execution settings</h3><div class=\"monster-afk-basic-grid monster-afk-execution-grid\"><div class=\"monster-afk-squad-field\"><span>Squad Assignments</span><div class=\"monster-afk-squads\" role=\"group\" aria-label=\"Squad Assignments\"><button class=\"monster-afk-squad-toggle\" type=\"button\" aria-label=\"Squad 1\" aria-pressed=\"true\" title=\"Squad 1\">1</button><button class=\"monster-afk-squad-toggle\" type=\"button\" aria-label=\"Squad 2\" aria-pressed=\"false\" title=\"Squad 2\">2</button><button class=\"monster-afk-squad-toggle\" type=\"button\" aria-label=\"Squad 3\" aria-pressed=\"false\" title=\"Squad 3\">3</button><button class=\"monster-afk-squad-toggle\" type=\"button\" aria-label=\"Squad 4\" aria-pressed=\"false\" title=\"Squad 4\">4</button></div></div><label title=\"Counted separately per squad after each completed attack or rally; 0 loops indefinitely\">Execution count (0 = unlimited)<input type=\"number\" min=\"0\" step=\"1\" value=\"0\"></label></div><label class=\"monster-afk-check-row\"><input type=\"checkbox\" checked=\"\">Continuous attacks (no return)</label></section><section class=\"monster-afk-config-section\"><h3>Target filters</h3><div class=\"monster-afk-filter\"><label class=\"monster-afk-check-row\"><input type=\"checkbox\">Limit level</label></div><div class=\"monster-afk-filter\"><label class=\"monster-afk-check-row\"><input type=\"checkbox\">Limit distance</label></div></section></div>",
