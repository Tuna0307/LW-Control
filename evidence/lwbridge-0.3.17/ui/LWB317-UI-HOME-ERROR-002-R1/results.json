      "callback": "() => {\n    if (!backendBridge.available || !selectedProfileId) return;\n    backendBridge.invoke(\"game_root_status\", {})\n      .then(acknowledgeGameRootStatus)\n      .catch((error) => setGameRootError(error?.message || String(error)));\n  }",
