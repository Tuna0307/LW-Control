      "text": "function normalizeSelectedTypes(types) {\r\n  const selected = [...new Set((types || []).filter((kind) => MAP_KIND_KEYS.includes(kind)))];\r\n  return selected.length ? selected : [...MAP_KIND_KEYS];\r\n}"
