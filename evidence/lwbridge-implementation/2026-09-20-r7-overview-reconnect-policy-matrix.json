  "acceptanceMapping": {
    "enabledObservedDisconnect": "With the owned process still present but bridge heartbeat unavailable, no termination/restart occurs before 60 seconds. At exactly the recovered threshold the exact owned identity is terminated once, the old session is restored once, one lifecycle relaunch occurs, and repairing/launching/verifying states lead to idle restarted after the 15-second stable gate.",
    "disabledObservedDisconnect": "With AutoReconnect=false and desired-running true, repeated observations beyond the disconnect/login-unavailable thresholds perform zero termination, zero recovery cleanup and zero relaunch; recovery remains idle.",
    "disableDuringRecovery": "A failed recovery launch enters the recovered first 15-second retry. The public set_automation command disables reconnect during that delay, cancels the active recovery token, returns recovery status to idle, preserves GameDesiredRunning=true, and repeated future observations produce zero more launches.",
    "intentionalStopSuppression": "After a successful enabled recovery, intentional Stop clears GameDesiredRunning and subsequent recovery observations do not resurrect the game."
  },
  "adjacentA06Audit": {
    "status": "remains_partial",
    "reason": "R7-012 proves map_scan_stop itself reaches terminal idle, but current evidence does not establish that Home profile_instance_stop owns/cancels an active Manual Map scan. Production lifecycle Stop has no recovered source-backed coupling to ManualMapScanCommandService. Do not invent that coupling."
  },
