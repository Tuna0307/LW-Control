{
  "schemaVersion": 1,
  "checkpoint": "LWB-R8-074",
  "date": "2026-09-26",
  "implementationChanged": false,
  "commands": {
    "map_dispatch_share_alliance": {
      "handler": "0x140163EF2-0x1401651C5",
      "payload": "{rows:[{uuid,serverId,x,y,cfgId,ownerName,allianceAbbr}],profileId?}",
      "authorizationStateRequired": true,
      "validation": {
        "rowCount": "1..200",
        "countError": {
          "code": "INVALID_REQUEST",
          "message": "select between 1 and 200 dispatch tasks"
        },
        "rowRequirements": [
          "uuid nonempty decimal string",
          "serverId positive integer-like",
          "x positive integer-like",
          "y positive integer-like",
          "cfgId positive integer-like"
        ],
        "rowError": {
          "code": "INVALID_REQUEST",
          "message": "selected dispatch task cannot be shared"
        }
      },
      "execution": {
        "order": "sequential after complete input validation",
        "provider": "shareDispatchTaskToAlliance",
        "timeoutMsPerRow": 5000,
        "successPredicate": "provider object has exact boolean shared=true",
        "resultConversion": "shared generic JSON converter per provider result"
      },
      "publicResultFields": ["shared","failed","sharedUuids","failedUuids"],
      "runtimeImplementation": "FENCED"
    },
    "map_treasure_claim": {
      "handler": "0x1401686E4-0x14016A011",
      "payload": "{serverId,claimScope,prioritizeLuckySlots,targetUuid,profileId?}",
      "authorizationStateRequired": true,
      "serverDomain": "1..99999",
      "serverErrors": [
        {"code":"INVALID_SERVER_ID","message":"server ID is required"},
        {"code":"INVALID_SERVER_ID","message":"server ID must be an integer from 1 to 99999"}
      ],
      "currentServerPreflight": {
        "provider": "getCurrentServerId",
        "timeoutMs": 5000,
        "unavailable": {"code":"SERVER_UNAVAILABLE","message":"current server id unavailable"},
        "mismatch": {"code":"SERVER_MISMATCH","message":"current game server does not match map data server"}
      },
      "claimScopes": ["boxes","season","single"],
      "singleRequiresTargetUuid": true,
      "scopeError": {"code":"INVALID_TREASURE_CLAIM_SCOPE","message":"treasure claim scope is invalid"},
      "prioritizeLuckySlotsDefault": true,
      "candidateQuery": {
        "table": "map_records",
        "kind": "treasure",
        "serverScoped": true,
        "supportedSuppliesTypes": [1,3,4],
        "ordinaryTreasureRequiresComplete": true,
        "uuidMustBeNonemptyNonzero": true,
        "expiredRowsExcluded": true,
        "order": "point_index ASC"
      },
      "provider": {
        "method": "claimTreasures",
        "timeoutMs": 5000,
        "requestFields": ["serverId","records","claimScope","targetUuid","prioritizeLuckySlots"]
      },
      "publicImmediateFields": [
        "eligible","queued","skipped","directQueued","scoutQueued","scoutDispatched",
        "claimed","noScoutSkipped","otherAllianceSkipped","failed"
      ],
      "frontendPolling": {
        "when": "queued > 0",
        "intervalMs": 1000,
        "maxIterations": 1800,
        "terminalRule": "optional batch.state != running"
      },
      "runtimeImplementation": "FENCED"
    }
  },
  "fenceReason": "Both state-changing actions require mandatory owner-excluded authorization-state admission before protected provider execution; bypassing it would change observable native behavior.",
  "retainedFrontendInventory": {
    "retainedCommands": 94,
