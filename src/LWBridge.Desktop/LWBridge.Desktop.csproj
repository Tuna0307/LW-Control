<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>LWBridge.Desktop</AssemblyName>
    <RootNamespace>LWBridge.Desktop</RootNamespace>
    <ApplicationIcon>lwbridge.ico</ApplicationIcon>
    <CanonicalUiProjectDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\LWBridge.UI-0.3.17'))</CanonicalUiProjectDir>
    <CanonicalUiIntermediateDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\ProductionUi'))</CanonicalUiIntermediateDir>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="WebUi\index.html;WebUi\preview-host.js;WebUi\presentation.css;WebUi\assets\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\run_live_resource_probe.py;..\..\tools\run_live_resource_probe_current.py;..\..\tools\current_client_compat.py;..\..\tools\current_live_resource_probe.lua"
             Link="LiveResourceProbe\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\run_overview_bridge.py;..\..\tools\run_overview_bridge_current.py;..\..\tools\recover_overview_pending_current.py;..\..\tools\current_overview_bridge.lua;..\..\tools\run_live_resource_probe.py;..\..\tools\current_client_compat.py;..\..\tools\current_live_resource_probe.lua"
             Link="OverviewBridge\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LWBridge.GamePipeAdapter\LWBridge.GamePipeAdapter.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\LWBridge.Map-0.3.17\LWBridge.Map-0.3.17.csproj" />
    <Content Include="..\LWBridge.GamePipeAdapter\bin\$(Configuration)\netstandard2.0\LWBridge.GamePipeAdapter.dll"
             Link="OverviewBridge\LWBridge.GamePipeAdapter.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <Target Name="RemoveUnusedWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

  <Target Name="BuildCanonicalProductionUi"
          BeforeTargets="BeforeBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipCanonicalProductionUiBuild)' != 'true'">
    <Message Importance="high" Text="Building canonical LWBridge.UI-0.3.17 production frontend" />
    <Exec Command="npm.cmd --prefix &quot;$(CanonicalUiProjectDir)&quot; ci --no-audit --no-fund" />
    <Exec Command="npm.cmd --prefix &quot;$(CanonicalUiProjectDir)&quot; run build -- --outDir &quot;$(CanonicalUiIntermediateDir)&quot;" />
    <Exec Command="node &quot;$(CanonicalUiProjectDir)\scripts\check-production-build.mjs&quot; &quot;$(CanonicalUiIntermediateDir)&quot;" />
    <RemoveDir Directories="$(OutDir)ProductionUi" Condition="Exists('$(OutDir)ProductionUi')" />
    <ItemGroup>
      <_CanonicalUiFiles Include="$(CanonicalUiIntermediateDir)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_CanonicalUiFiles)"
          DestinationFiles="@(_CanonicalUiFiles->'$(OutDir)ProductionUi\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <Target Name="PublishCanonicalProductionUi"
          AfterTargets="Publish"
          DependsOnTargets="BuildCanonicalProductionUi"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipCanonicalProductionUiBuild)' != 'true'">
    <RemoveDir Directories="$(PublishDir)ProductionUi" Condition="Exists('$(PublishDir)ProductionUi')" />
    <ItemGroup>
      <_CanonicalUiPublishFiles Include="$(CanonicalUiIntermediateDir)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_CanonicalUiPublishFiles)"
          DestinationFiles="@(_CanonicalUiPublishFiles->'$(PublishDir)ProductionUi\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
